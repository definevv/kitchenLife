<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:paddingTop="16dp">

    <!-- 상단 앱바 영역 -->
    <LinearLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.AppCompat.ImageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="@string/back"
            android:tint="@color/icon_dark" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/cooking_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/Widget.AppCompat.ImageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert_24"
            android:contentDescription="@string/more"
            android:tint="@color/icon_dark" />
    </LinearLayout>

    <!-- 내용 영역 전체 -->
    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Step 표시 -->
        <TextView
            android:id="@+id/tv_step_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 2 / 8"
            android:textColor="@color/text_subtle"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- 조리 지시문 -->
        <TextView
            android:id="@+id/tv_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="돼지고기를 중불에서 3분간 뒤집어가며 굽습니다."
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- 타이머 제안 카드 (필요시만 보임) -->
        <LinearLayout
            android:id="@+id/layout_timer_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@drawable/bg_timer_card"
            android:gravity="center_vertical"
            android:layout_marginBottom="40dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/iv_timer_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle_soft"
                android:padding="6dp"
                android:src="@drawable/ic_lightbulb_24"
                android:tint="@color/icon_accent"/>

            <TextView
                android:id="@+id/tv_timer_suggestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="3분 타이머를 설정할까요?"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_weight="1"/>
        </LinearLayout>

        <!-- 중앙 마이크 버튼 -->
        <FrameLayout
            android:id="@+id/btn_mic"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_mic_button">

            <ImageView
                android:id="@+id/iv_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic_24"
                android:tint="@color/icon_accent"/>
        </FrameLayout>

        <!-- 남는 공간 밀어내기 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/prev"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_button"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_repeat"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/repeat"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_button"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/next"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_button"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
