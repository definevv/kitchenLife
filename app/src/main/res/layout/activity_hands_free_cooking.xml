<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:paddingTop="8dp">

    <!-- 상단 앱바 영역 (OneUI 스타일: 여백 넉넉 + 좌우 아이콘) -->
    <LinearLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.AppCompat.ImageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="@string/back"
            android:tint="@color/icon_dark" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/cooking_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/Widget.AppCompat.ImageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert_24"
            android:contentDescription="@string/more"
            android:tint="@color/icon_dark" />
    </LinearLayout>
    <!-- 🎤 중앙 마이크 버튼 (Two-layer circle) -->
    <!-- 마이크 버튼 : 항상 화면의 아래 버튼 바로 위에 고정 -->
    <FrameLayout
        android:id="@+id/mic_outer"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_mic_outer"
        android:gravity="center"
        android:layout_marginBottom="70dp"

        app:layout_constraintBottom_toTopOf="@id/layout_bottom_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/mic_inner_circle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_mic_inner"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/btn_mic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_mic_24"
            android:tint="#35A852"
            android:layout_gravity="center"/>
    </FrameLayout>


    <!-- 본문 영역 (단계 카드 + 타이머 카드) -->
    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ❑ 조리 단계 카드 (OneUI 카드 스타일) -->
        <LinearLayout
            android:id="@+id/card_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_instruction_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_step_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 / 6"
                android:textColor="@color/text_subtle"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="조리 단계를 불러오는 중..."
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- 💡 타이머 제안 카드 -->
        <LinearLayout
            android:id="@+id/layout_timer_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:background="@drawable/bg_timer_card"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_timer_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle_soft"
                android:padding="6dp"
                android:src="@drawable/ic_lightbulb_24"
                android:tint="@color/icon_accent"/>

            <TextView
                android:id="@+id/tv_timer_suggestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="3분 타이머를 설정할까요?"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_weight="1"/>
        </LinearLayout>


        <!-- 🔥 실제 카운트다운되는 타이머 UI -->
        <TextView
            android:id="@+id/tv_timer_running"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="00:00"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_timer_running"
            android:visibility="gone"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center_horizontal"
            android:elevation="6dp" />

        <!-- 위쪽 공간 살짝 확보 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- 하단 버튼 영역 (OneUI 스타일 pill + 그림자 + 위로 살짝 띄우기) -->
    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/prev"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_button"
            android:elevation="6dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_repeat"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/repeat"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_button"
            android:elevation="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/next"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_button"
            android:elevation="6dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
