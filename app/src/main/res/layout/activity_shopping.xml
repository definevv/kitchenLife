<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 메인 컨텐츠(세로 레이아웃) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/header_gray"
            android:elevation="4dp"
            app:title="Shopping"
            app:titleTextColor="@color/text_primary" />

        <!-- Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/background_gray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title + Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <!-- Left: Title -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shopping List"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- Add manually -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_item"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADD"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart" />

                    <!-- Add from recipe -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_from_recipe"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECIPE"
                        android:layout_marginStart="8dp"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- ▼ 여기: 전체 선택 + 팬트리로 (요청한 위치) -->
                <LinearLayout
                    android:id="@+id/row_select_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:gravity="center_vertical">

                    <!-- 글자만 있는 '전체 선택' -->
                    <TextView
                        android:id="@+id/tv_select_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전체 선택"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="?attr/colorPrimary"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <!-- 체크된 항목 삭제 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_selected"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="@color/background_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="리스트 삭제"
                        android:textSize="14sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="8dp"
                        android:enabled="false"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                    <!-- '더 버튼' 느낌: 선택 항목 팬트리로 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_move_to_pantry"
                        style="@style/Widget.Material3.Button.ElevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="팬트리로 이동"
                        android:textSize="14sp"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="@color/green_primary"
                        android:textColor="@android:color/white"

                        app:iconPadding="6dp"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- 구분선(옵션) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1F000000"
                    android:layout_marginBottom="6dp" />

                <!-- List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_shopping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Progress overlay: 화면 전체 덮음 -->
    <View
        android:id="@+id/progress_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

</FrameLayout>
